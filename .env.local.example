# Copy this file to .env.local and fill in real values.
#   cp .env.local.example .env.local
# .env.local is git-ignored — never commit real keys.
# On Vercel, add the same variables under Project → Settings → Environment Variables.
#
# NEXT_PUBLIC_* variables are sent to the browser. Everything else is server-only.

# ─── Site ───────────────────────────────────────────────────
# Public URL of the app. http://localhost:3000 locally; your Vercel/custom domain in production.
# Used in SMS/email links (booking confirmation, review requests).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ───────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / "publishable" key — safe for the browser, restricted by Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# "service_role" / "secret" key — SERVER ONLY, bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google Maps ────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials (https://console.cloud.google.com/apis/credentials)
# Enable: "Places API (New)" and "Routes API" (Routes replaces the legacy Distance Matrix API).
# SERVER ONLY — address search (/api/places) and distances (/api/quote) both go through
# our API routes, so the browser never loads the Google Maps SDK or sees this key.
# Restrict the key to those two APIs.
GOOGLE_MAPS_SERVER_API_KEY=your-server-maps-key

# ─── Twilio (SMS + WhatsApp) ────────────────────────────────
# Twilio Console home page → Account Info (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Twilio Console → Phone Numbers → Manage → Active numbers. E.164 format.
TWILIO_SMS_FROM=+61400000000
# Twilio Console → Messaging → Senders → WhatsApp senders (or the sandbox number while testing)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Resend (email) ─────────────────────────────────────────
# Resend Dashboard → API Keys (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be on a domain you've verified in Resend → Domains
RESEND_FROM_EMAIL=bookings@yourdomain.com.au

# ─── Owner / admin notifications ────────────────────────────
# Where new-booking alerts go (your own mobile and email)
ADMIN_PHONE=+61400000000
ADMIN_EMAIL=you@yourdomain.com.au

# ─── Reviews ────────────────────────────────────────────────
# Google Business Profile → Ask for reviews → copy the short link
GOOGLE_REVIEW_URL=https://g.page/r/your-review-link/review
